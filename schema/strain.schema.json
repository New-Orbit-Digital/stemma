{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stemma.neworbitdigital.com/schema/strain.schema.json",
  "title": "Stemma strain card v1",
  "description": "Reference only. tools/validate.py (stdlib) enforces the rules in docs/schema.md, which is authoritative.",
  "type": "object",
  "required": ["id", "name", "kind", "status", "updated"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "kind": { "enum": ["landrace", "cultivar", "cut"] },
    "status": { "enum": ["stub", "draft", "reviewed"] },
    "summary": { "type": "string", "maxLength": 400 },
    "born": { "type": "object" },
    "origin": { "type": "object" },
    "breeder": { "type": ["object", "null"] },
    "lineage": {
      "type": "object",
      "properties": {
        "status": { "enum": ["root", "known", "partial", "unknown", "disputed"] },
        "parents": { "type": "array", "items": { "$ref": "#/$defs/parent" } },
        "disputes": { "type": "array" }
      }
    },
    "traditional_label": { "enum": ["indica", "sativa", "hybrid", "unknown"] },
    "growing": { "type": "object" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["tier", "source"],
      "properties": {
        "tier": { "enum": ["genetically-tested", "documented", "breeder-claimed", "folklore"] },
        "source": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "parent": {
      "type": "object",
      "required": ["id", "evidence"],
      "properties": { "id": { "type": "string" }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "minItems": 1 } }
    },
    "source": {
      "type": "object",
      "required": ["id", "title"],
      "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "publisher": { "type": "string" }, "url": { "type": "string" }, "accessed": { "type": "string" } }
    }
  }
}
